SPRING_PROFILES_ACTIVE=prod
PORT=8080

DATABASE_URL=jdbc:postgresql://your-postgres-host:5432/inka
DATABASE_USERNAME=your_database_user
DATABASE_PASSWORD=your_database_password

JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_EXPIRATION_MS=86400000

APP_FRONTEND_URL=https://your-frontend-domain.example
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-api-domain.example/login/oauth2/code/google

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=https://your-frontend-domain.example/payment/success
STRIPE_CANCEL_URL=https://your-frontend-domain.example/payment/cancel
